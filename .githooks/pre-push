#!/bin/sh
set -eu

gate=.githooks/backlog-gate
if [ ! -e "$gate/config.json" ] && [ ! -e "$gate/commit-links.mjs" ] &&
    ! git cat-file -e "HEAD:$gate/config.json" 2>/dev/null; then
    printf 'pre-push: this tree has never configured the backlog integration; not checked here\n' >&2
    exit 0
fi
for f in adapter.mjs check.mjs time-format.mjs regular-file.mjs argv.mjs merge-gate.mjs check-commits.mjs commit-links.mjs config.json; do
    if [ ! -r "$gate/$f" ]; then
        printf 'pre-push: %s is missing or unreadable; run make connect\n' "$gate/$f" >&2
        exit 2
    fi
done
for command in node br git; do
    command -v "$command" >/dev/null 2>&1 || {
        printf 'pre-push: %s is missing; run make connect\n' "$command" >&2
        exit 2
    }
done

# Publish and sync the external tracker ref, not a code-tree JSONL file.
# status --json can return zero while reporting an unreachable remote, a
# checkout that does not reach the store, unpublished work, or a stopped
# supervisor. Read what it says instead of treating the exit code as the answer.
status_json=$(node "$gate/tracker-sync.mjs" status --json --repo "$(git rev-parse --show-toplevel)" --recipe "$gate/trackers/br.mjs" </dev/null) || {
    printf 'pre-push: tracker-sync status failed; run make connect\n' >&2
    exit 2
}
if ! printf '%s' "$status_json" | node -e '
let s = "";
process.stdin.on("data", (d) => (s += d));
process.stdin.on("end", () => {
  const x = JSON.parse(s);
  const bad = [];
  if (x.unreachable) bad.push(`remote unreachable${x.said ? `: ${x.said}` : ""}`);
  if (x.errorClass) bad.push(`status error class ${x.errorClass}`);
  for (const c of x.checks || []) if (!c.ok) bad.push(`${c.checkout} does not reach the store`);
  if (bad.length) {
    console.error(`pre-push: tracker status: ${bad.join("; ")}`);
    process.exit(1);
  }
  if (x.queued && x.queued.unpublished) console.error(`pre-push: WARN ${x.queued.unpublished} tracker change(s) unpublished`);
  if (!x.supervisor || !x.supervisor.alive) console.error("pre-push: WARN tracker sync supervisor is not running");
});
'; then
    exit 2
fi

remote=${1:-}
url=${2:-$remote}
[ -n "$remote" ] || { printf 'pre-push: remote name is missing\n' >&2; exit 2; }
refs=$(node "$gate/commit-links.mjs" --parse-pre-push) || exit 2
[ -n "$refs" ] || { printf 'pre-push: stdin contains no ref lines\n' >&2; exit 2; }

while IFS="$(printf '\t')" read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue
    case "$local_sha" in
        *[!0-9a-f]*|'') printf 'pre-push: unreadable local object %s\n' "$local_sha" >&2; exit 2 ;;
    esac
    case "$remote_sha" in
        *[!0-9a-f]*|'') printf 'pre-push: malformed remote object %s\n' "$remote_sha" >&2; exit 2 ;;
    esac
    case "$local_sha" in
        *[!0]*) : ;;
        *) continue ;;
    esac
    if ! tip=$(git rev-parse -q --verify "$local_sha^{commit}" 2>/dev/null); then
        printf 'pre-push: %s does not peel to a readable commit\n' "$local_ref" >&2
        exit 2
    fi
    set -- --introduced "$tip" --by "$remote_ref" --remote "$url"
    case "$remote_sha" in
        *[!0]*) set -- "$@" --before "$remote_sha" ;;
    esac
    node "$gate/commit-links.mjs" "$@" || { status=$?; exit "$status"; }

    # A code push carries no tracker state: the store lives on
    # refs/tracker/state and is published separately. Comparing this branch's
    # parent with the live store would gate the push on other agents' writes.
    printf 'pre-push: backlog comparison skipped (tracker state is not part of a code push)\n' >&2
done <<EOF_REFS
$refs
EOF_REFS
