#!/bin/sh
set -eu

gate=.githooks/backlog-gate
if [ ! -e "$gate/config.json" ] && [ ! -e "$gate/commit-links.mjs" ] &&
    ! git cat-file -e "HEAD:$gate/config.json" 2>/dev/null; then
    printf 'pre-push: this tree has never configured the backlog integration; not checked here\n' >&2
    exit 0
fi
for f in adapter.mjs check.mjs time-format.mjs merge-gate.mjs check-commits.mjs commit-links.mjs config.json; do
    if [ ! -r "$gate/$f" ]; then
        printf 'pre-push: %s is missing or unreadable; run make connect\n' "$gate/$f" >&2
        exit 2
    fi
done
for command in node br git; do
    command -v "$command" >/dev/null 2>&1 || {
        printf 'pre-push: %s is missing; run make connect\n' "$command" >&2
        exit 2
    }
done

# Preserve the tracker warning, but never let it replace the mandatory gates.
if br --no-auto-import --no-auto-flush where >/dev/null 2>&1; then
    if ! br --no-auto-import --no-auto-flush sync --status 2>/dev/null | grep -q "Dirty issues: 0"; then
        printf '\nWARN: br has changes that never reached .beads/issues.jsonl.\n' >&2
        printf '      br sync --flush-only && git add .beads/issues.jsonl\n' >&2
    fi
fi
if ! git diff --quiet -- .beads/issues.jsonl 2>/dev/null; then
    printf '\nWARN: .beads/issues.jsonl is modified and uncommitted — the backlog stays here.\n' >&2
    printf '      git add .beads/issues.jsonl && git commit\n' >&2
fi

remote=${1:-}
url=${2:-$remote}
[ -n "$remote" ] || { printf 'pre-push: remote name is missing\n' >&2; exit 2; }
refs=$(node "$gate/commit-links.mjs" --parse-pre-push) || exit 2
[ -n "$refs" ] || { printf 'pre-push: stdin contains no ref lines\n' >&2; exit 2; }

while IFS="$(printf '\t')" read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue
    case "$local_sha" in
        *[!0-9a-f]*|'') printf 'pre-push: unreadable local object %s\n' "$local_sha" >&2; exit 2 ;;
    esac
    case "$remote_sha" in
        *[!0-9a-f]*|'') printf 'pre-push: malformed remote object %s\n' "$remote_sha" >&2; exit 2 ;;
    esac
    case "$local_sha" in
        *[!0]*) : ;;
        *) continue ;;
    esac
    if ! tip=$(git rev-parse -q --verify "$local_sha^{commit}" 2>/dev/null); then
        printf 'pre-push: %s does not peel to a readable commit\n' "$local_ref" >&2
        exit 2
    fi
    set -- --introduced "$tip" --by "$remote_ref" --remote "$url"
    case "$remote_sha" in
        *[!0]*) set -- "$@" --before "$remote_sha" ;;
    esac
    node "$gate/commit-links.mjs" "$@" || { status=$?; exit "$status"; }

    introduced=$(node "$gate/commit-links.mjs" --list-introduced "$@") || exit 2
    [ -n "$introduced" ] || continue
    first=$(printf '%s\n' "$introduced" | while IFS= read -r row; do printf '%s\n' "$row"; break; done)
    baseline=$remote_sha
    case "$baseline" in
        *[!0]*)
            if ! git merge-base --is-ancestor "$baseline" "$tip"; then
                baseline=$(printf '%s\n' "$first" | awk '{print $2}')
            fi
            ;;
        *) baseline=$(printf '%s\n' "$first" | awk '{print $2}') ;;
    esac
    if [ -z "$baseline" ] || ! git rev-parse -q --verify "$baseline^{commit}" >/dev/null 2>&1; then
        printf 'pre-push: no valid preceding backlog revision for %s\n' "$remote_ref" >&2
        exit 2
    fi
    baseline_file=$(mktemp)
    staged_file=$(mktemp)
    baseline_config=$(mktemp)
    tip_config=$(mktemp)
    if ! node "$gate/adapter.mjs" --at "$baseline" >"$baseline_file" ||
        ! node "$gate/adapter.mjs" --at "$tip" >"$staged_file" ||
        ! git show "$tip:$gate/config.json" >"$tip_config"; then
        rm -f "$baseline_file" "$staged_file" "$baseline_config" "$tip_config"
        printf 'pre-push: backlog export or configuration cannot be read at the pushed revisions\n' >&2
        exit 2
    fi
    set --
    if git show "$baseline:$gate/config.json" >"$baseline_config" 2>/dev/null; then
        set -- --baseline-config "$baseline_config"
    fi
    node "$gate/check.mjs" --config "$tip_config" --baseline "$baseline_file" "$@" "$staged_file" || {
        status=$?
        rm -f "$baseline_file" "$staged_file" "$baseline_config" "$tip_config"
        exit "$status"
    }
    rm -f "$baseline_file" "$staged_file" "$baseline_config" "$tip_config"
done <<EOF_REFS
$refs
EOF_REFS
