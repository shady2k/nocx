{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/vault.createSecret.params.schema.json",
  "title": "VaultCreateSecretParams",
  "description": "Params for vault.createSecret.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "kind"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Display name for the secret; braces and control characters are not allowed."
    },
    "kind": {
      "type": "string",
      "enum": ["password", "key-passphrase", "private-key", "public-key", "otp-seed", "api-token"]
    },
    "value": {
      "type": "string",
      "maxLength": 64000,
      "description": "Secret material to store; never log or echo it."
    },
    "path": { "type": "string", "maxLength": 64000 },
    "resolve": { "type": "boolean" }
  }
}
