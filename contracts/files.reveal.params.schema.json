{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/files.reveal.params.schema.json",
  "title": "FilesRevealParams",
  "description": "Params for files.reveal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bindingId", "path"],
  "properties": {
    "bindingId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "path": { "type": "string", "pattern": "^/", "maxLength": 4096 }
  }
}
