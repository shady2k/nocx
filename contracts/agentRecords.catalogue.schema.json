{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRecordsCatalogueResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "readiness": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {
                "enum": ["not_installed", "not_configured", "ready"],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["state", "message"]
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": ["id", "name"]
            }
          }
        },
        "required": ["id", "readiness", "models"]
      }
    }
  },
  "required": ["agents"],
  "$id": "https://nocx.local/contracts/agentRecords.catalogue.schema.json"
}
