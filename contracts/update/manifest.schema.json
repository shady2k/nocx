{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/update/manifest.schema.json",
  "title": "Signed update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "released", "notesUrl", "build", "artifacts", "helpers"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "released": {
      "type": "string",
      "format": "date-time"
    },
    "notesUrl": {
      "type": "string"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "builtAt"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "builtAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["os", "arch", "format", "url", "sha256", "size"],
        "properties": {
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "helpers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["os", "arch", "url", "sha256", "size"],
        "properties": {
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
