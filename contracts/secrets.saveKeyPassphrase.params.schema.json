{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/secrets.saveKeyPassphrase.params.schema.json",
  "title": "SecretsSaveKeyPassphraseParams",
  "description": "Params for secrets.saveKeyPassphrase.",
  "type": "object",
  "additionalProperties": false,
  "required": ["keyRow", "passphrase"],
  "properties": {
    "keyRow": { "type": "string", "pattern": "^secrow:[0-9a-f]{32}$" },
    "passphrase": {
      "type": "string",
      "maxLength": 64000,
      "description": "Passphrase used to unlock the private key; never log or echo it."
    },
    "name": { "type": "string", "maxLength": 200 }
  }
}
