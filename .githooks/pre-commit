#!/bin/sh
set -eu

warn() { printf "FAIL: %s\n" "$1"; }
ok()   { printf "OK:   %s\n" "$1"; }

# go-installed tools (gofumpt, golangci-lint) live in $(go env GOPATH)/bin, which
# an interactive shell has on PATH but a hook invoked by an editor or a sandboxed
# process may not. Add it so the checks below find them wherever the hook runs.
command -v go >/dev/null 2>&1 && PATH="$(go env GOPATH)/bin:$PATH"

# --- check all binaries first, report all missing together ------------------
CHECK_CMD_TRUE=true
check_cmd() {
    if ! command -v "$1" >/dev/null 2>&1; then
        warn "$1 not found — install: $2"
        CHECK_CMD_TRUE=false
    fi
}

check_cmd gofumpt "go install mvdan.cc/gofumpt@latest"
check_cmd golangci-lint "go install github.com/golangci/golangci-lint/cmd/golangci-lint@v1.64.8"
check_cmd go "install Go from https://go.dev/dl/"
check_cmd node "install Node.js from https://nodejs.org/"
check_cmd npm "install Node.js from https://nodejs.org/"

if [ ! -d frontend/node_modules ]; then
    warn "frontend/node_modules not found — run: cd frontend && npm ci"
    CHECK_CMD_TRUE=false
fi

if [ "$CHECK_CMD_TRUE" = false ]; then
    printf "\nPre-commit hook FAILED — install missing tools above and try again.\n"
    exit 1
fi

# --- 0. what does this commit touch? ----------------------------------------
# Scope the expensive per-language gates to the language the commit changes. The
# rule is conservative in one direction only: anything we cannot classify runs
# everything. A commit that cannot be classified is cheap; a commit that skips a
# gate it needed is a broken commit in a history AGENTS.md expects to bisect.
#
# Deletions are NOT filtered out — removing a file breaks a build as readily as
# editing one. An empty staged set (an --amend that changes only the message)
# also runs everything, because "nothing staged" is not evidence of safety.
RUN_GO=1
RUN_FE=1
RUN_E2E=1
CHANGED=$(git diff --cached --name-only 2>/dev/null || true)
if [ -n "$CHANGED" ]; then
    RUN_GO=0
    RUN_FE=0
    RUN_E2E=0
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        case "$f" in
            # The hook and the build system decide how everything else is
            # checked, so a change to either invalidates the scoping itself.
            .githooks/*|Makefile|.golangci.yml) RUN_GO=1; RUN_FE=1; RUN_E2E=1 ;;
            *.go|go.mod|go.sum)                 RUN_GO=1 ;;
            frontend/*)                         RUN_FE=1 ;;
            e2e/*|playwright.config.ts)         RUN_E2E=1 ;;
        esac
    done <<CHANGED_EOF
$CHANGED
CHANGED_EOF
fi

# host_gate runs a check and, on failure, prints it and aborts the commit.
host_gate() {
    _label=$1
    shift
    if ! "$@" 2>&1; then
        warn "$_label"
        printf "\nPre-commit hook FAILED. Fix the issues above and try again.\n"
        exit 1
    fi
    ok "$_label"
}

# --- 1. NO TESTS RUN HERE, and that is the decision, not an omission --------
# This hook used to start two containers on every commit — `go test -race` in
# .githooks/images/go-tests and vitest in a node image — which its own comment
# measured at 72% of the hook's wall time. They are gone (nocx-hzsiv), together
# with the docker requirement above and the containerized-tests.sh helper whose
# only caller they were.
#
# The reason is not speed alone. A test runner is the most expensive thing this
# machine does, and several agent worktrees commit at once: on 2026-08-27 three
# concurrent hooks left 232 MB of free RAM with swap full, a gate child was
# OOM-killed, and this hook reported the death as `FAIL: eslint (frontend)`
# with no diagnostic under it (nocx-y6d9j). Two workers read that as broken
# infrastructure and committed with --no-verify — a gate starved into lying is
# worse than a gate that does less.
#
# So the per-commit gate is STATIC: formatting, linting, type-checking, the
# ratchets, the wire contracts, and the beads export. Say the cost out loud —
# a commit can now be made whose tests do not pass. The suites keep their teeth
# at three addresses that already existed:
#
#   make test            on demand, on this host
#   make ci-full         the integrator, once, on the merged tree (AGENTS.md)
#   ci.yml               every pull request, in the environment each job owns
#
# --- 2. gofumpt (always: one second, and it reads the whole module) ----------
# THE FILE LIST COMES FROM GIT, never from a walk of the directory tree.
# `gofumpt -l .` descends into everything on the path, and agent worktrees are
# ON the path: Claude Code's worktree isolation checks other branches out at
# .claude/worktrees/<id>/, inside this root. Those carry whatever formatting
# their commit had, cannot be corrected from here, and blocked EVERY commit in
# the repository — a docs-only change included — until somebody removed the
# worktree (nocx-290r5).
#
# Go's own tooling never had this problem, which is why only this line did:
# `./...` skips directories whose name begins with a dot, so go build, go test
# and the golangci-lint step below have always been blind to them. prettier was
# taught the same lesson once already, and .prettierignore says so in as many
# words for test-results/ — "prettier walks the filesystem rather than the
# index, so an ignored directory still failed `prettier --check .`".
#
# -c -o --exclude-standard is "tracked, plus untracked that .gitignore does not
# exclude", so a .go file written and not yet added is still checked and this
# is not a weaker gate than the walk. git does not descend into a nested
# worktree; the pathspec then says .claude is out however it got there. -z with
# xargs -0 because a path with a space must not become two arguments, and -0 is
# the one xargs flag both BSD and GNU spell the same way.
UNFMT=$(git ls-files -zco --exclude-standard -- '*.go' ':(exclude).claude/**' \
    | xargs -0 gofumpt -l 2>&1) || true
if [ -n "$UNFMT" ]; then
    warn "gofumpt — the following files need formatting:"
    printf "%s\n" "$UNFMT"
    printf "\nPre-commit hook FAILED. Fix the issues above and try again.\n"
    exit 1
fi
ok "gofumpt"

# --- 3. golangci-lint (always: it is cached and effectively free) -----------
# The Wails v3 module compiles cgo against WebKitGTK, and v3 defaults to
# GTK4/webkitgtk-6.0 which this machine class does not carry; the gtk3 tag
# selects the 4.1 pkg-config path instead. Without it golangci-lint cannot
# typecheck the packages that import wails at all, and every commit fails
# on cgo rather than on anything the author wrote. Computed the same way
# the Makefile computes WAILS_PLATFORM_TAGS, and empty off Linux, where
# the default path already resolves.
GOLANGCI_TAGS=""
if [ "$(go env GOOS)" = "linux" ] && pkg-config --exists webkit2gtk-4.1 2>/dev/null; then
    GOLANGCI_TAGS="--build-tags=gtk3"
fi
# shellcheck disable=SC2086 # GOLANGCI_TAGS must word-split away when empty.
host_gate "golangci-lint" golangci-lint run $GOLANGCI_TAGS ./...

# --- 3b. deadcode ratchet: RUNS IN CI, in ci.yml's ci-mac and ci-linux jobs
# (nocx-re6gk) ----------------------------------------------------------------
# It used to run in this hook. Wails v3 ended that, and not by accident: the ratchet
# analysed darwin AND linux from whatever machine it ran on, which was only
# possible with CGO_ENABLED=0 — and v3 requires cgo for both targets (its own
# cross-platform guide: macOS "Yes / Docker with macOS SDK", Linux "Yes /
# Docker, or native if a C compiler is available"). There is no no-cgo mode to
# reach for; the option does not exist rather than being hard to find.
#
# The cross-GOOS-from-one-host trick existed only because a developer machine
# cannot be both a Mac and a Linux box. CI already has both, so each job
# analyses its OWN platform natively with cgo on, and the union baseline keeps
# working unchanged — a per-platform run is a subset of it, so a NEW violation
# still fails and only staleness goes unreported. That costs no Docker image
# and needs no macOS SDK licence, which the wails-cross image would have
# required us to accept into a mandatory gate.
#
# Removing it from here is deliberate and is NOT a downgrade to nothing: this
# repo has nocx-rtg0, where a write path with no caller shipped behind a green
# "deadcode is empty". The ratchet keeps its teeth; it changes address.
#
# To run it by hand on THIS platform: node .githooks/check-deadcode.mjs
# (~4 s here). It answers for the host and only the host, which is the whole
# reason the address changed.

# --- 3c. control goroutine ratchet (Go changes only, same reasoning as the
# deadcode ratchet: ~10ms, and the committed baseline is what makes a NEW
# `go` statement in control-handler code fail rather than the 13 legitimate
# infrastructure spawns) ----------------------------------------------------
if [ "$RUN_GO" = 1 ]; then
    host_gate "control goroutine ratchet" node .githooks/check-control-goroutines.mjs
else
    ok "control goroutine ratchet — skipped (no Go changes staged)"
fi

# --- 4. prettier (always) ---------------------------------------------------
# From the REPOSITORY ROOT, which is what the comment here always claimed and
# `cd frontend` always made false: the root carries its own .prettierrc.json,
# .prettierignore and format:check, and nothing ran them, so 16 files outside
# frontend/ drifted unformatted — three specs, eleven contract schemas and two
# ADRs — while a syntactically invalid e2e spec passed every gate in this file
# (nocx-yv37, nocx-pvjj). The root run includes frontend/ as a subdirectory, so
# this is one checker widened, not a second one added.
host_gate "prettier --check" npm run format:check

# The ROOT eslint, and always, for the same reason and with the same history as
# the prettier line above. The frontend gate below is `cd frontend && npm run
# lint`, so its territory is frontend/; the root config (eslint.config.mjs)
# owns everything else — e2e/**, playwright.config.ts, .githooks/**/*.mjs — and
# ignores frontend/ deliberately, because frontend has its own type-checked
# config. Nothing here ran it. Root eslint used to run in this hook, died on
# EACCES against the e2e container's root-owned .e2e/, and 19 errors piled up
# behind the crash (nocx-z9s9.8); the repair added the ignore and gave CI its
# own step, and widening the hook happened for prettier and not for eslint. So
# `INPUT` sat unused in a spec from the commit that introduced it until
# ci-frontend said so on a pull request. Two checkers, one widened, is how a
# gate keeps half its ground.
host_gate "eslint (root)" npm run lint

# --- 5. frontend-only host gates --------------------------------------------
if [ "$RUN_FE" = 1 ]; then
    host_gate "eslint (frontend)" sh -c 'cd frontend && npm run lint'
    host_gate "solid negative fixture gate" sh -c 'cd frontend && npm run lint:fixture-check'
    host_gate "wire contracts current" sh -c 'cd frontend && npm run contracts:check'
    host_gate "tsc --noEmit" sh -c 'cd frontend && npm run typecheck'
else
    ok "eslint (frontend), fixture gate, tsc — skipped (no frontend/ changes staged)"
fi

# --- 5b. the e2e suite is TypeScript nobody was checking --------------------
# The root tsconfig.json covers e2e/**/*.ts and playwright.config.ts, and it
# exists BECAUSE two specs shipped as compile errors and ran anyway (the file's
# own comment names nocx-azxe.2). Nothing invoked it: this hook only ever ran
# `cd frontend && npm run typecheck`. A gate that exists and is never called is
# the same defect as code on main that no caller reaches.
if [ "$RUN_E2E" = 1 ]; then
    host_gate "tsc --noEmit (e2e)" npm run typecheck
else
    ok "tsc --noEmit (e2e) — skipped (no e2e/ changes staged)"
fi

# --- 6. the landing page's structural gate ----------------------------------
# Cheap (no toolchain, no container), so it runs whenever it could have anything
# to say. It is also run by the deploy workflow: a page that fails it must not
# reach the public URL because someone skipped a local hook.
if printf '%s\n' "$CHANGED" | grep -qE '^(site/|scripts/check-site\.sh$|scripts/site-forbidden-phrases\.txt$)'; then
    if ! ./scripts/check-site.sh; then
        printf "\nPre-commit hook FAILED. Fix the issues above and try again.\n"
        exit 1
    fi
    ok "check-site"
else
    ok "check-site — skipped (no site/ changes staged)"
fi

# --- 7. beads: materialise the issue snapshot into this commit ---------------
# Last, deliberately: a gate that fails above must not leave .beads/issues.jsonl
# rewritten and staged for a commit that never happens.
. "$(dirname "$0")/beads-hook.sh"
export_beads_snapshot
ok "beads export"

printf "\nAll static checks passed.\n"

# What "all static checks passed" does NOT mean, spelled out because this hook
# once read as a faithful pre-flight and was not even when it ran tests: it ran
# them in Debian with the golang image's Go, no Secret Service, every core this
# host has and the test cache intact, where CI runs Ubuntu, setup-go, two
# keyring variants and -count=1. A release attempt and its follow-up PR both
# came back red from a job this hook had just called green (nocx-cn86).
#
# It now runs NO tests at all (nocx-hzsiv), so the gap is wider and simpler:
# nothing below has been executed, only read. A green commit here says the tree
# is formatted, linted, type-checked and contract-current. It says nothing
# whatever about whether the code works.
printf "  NOT covered here: any test at all              — \`make test\`, and CI on the PR\n"
printf "                    macOS (bash 3.2, no /proc, Darwin PTY) — CI's \`ci-mac\` job\n"
printf "                    Ubuntu + both keyring variants — scripts/ci-linux.sh\n"
printf "                    the e2e suite itself           — e2e/run-in-container.sh\n"
printf "                    the dead-code ratchet          — CI's \`ci-mac\` and \`ci-linux\` jobs\n"
