{
  "name": "nocx-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && node lint-fixtures/check-css-colors.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "lint:fixture-check": "sh ./lint-fixtures/gate.sh",
    "baseline:update": "node lint-fixtures/update-raw-controls-baseline.mjs",
    "baseline:color-update": "node lint-fixtures/update-color-literals-baseline.mjs",
    "baseline:inline-update": "node lint-fixtures/update-inline-markup-baseline.mjs"
  },
  "dependencies": {
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "css-tree": "^3.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-solid": "^0.14.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.0",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^3.2.7"
  }
}
