{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    // ES2022.Intl is the Intl declarations ALONE — Segmenter and friends —
    // added without moving the language target off ES2021. Grapheme
    // clustering is a Unicode table, not something to hand-roll beside the
    // one the engine already ships (nocx-4n6sj).
    "lib": ["ES2021", "ES2022.Intl", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
