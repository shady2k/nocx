{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string" },
    "path": { "type": "string" }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "content"],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "content": { "type": "string" }
      }
    }
  }
}
