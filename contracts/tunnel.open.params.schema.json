{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/tunnel.open.params.schema.json",
  "title": "TunnelOpenParams",
  "description": "Params for tunnel.open.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileId", "destination"],
  "properties": {
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "host": {
      "type": "string",
      "maxLength": 4096
    },
    "port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "scope": {
      "type": "string",
      "maxLength": 256
    }
  }
}
