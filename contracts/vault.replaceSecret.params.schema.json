{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/vault.replaceSecret.params.schema.json",
  "title": "VaultReplaceSecretParams",
  "description": "Params for vault.replaceSecret.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "pattern": "^secrow:[0-9a-f]{32}$" },
    "value": {
      "type": "string",
      "maxLength": 64000,
      "description": "Replacement secret material; never log or echo it."
    },
    "path": { "type": "string", "maxLength": 64000 }
  }
}
