{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/tabs.reorder.params.schema.json",
  "title": "TabsReorderParams",
  "description": "Params for reordering tabs in a workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspaceId", "ids"],
  "properties": {
    "workspaceId": {
      "type": "string",
      "pattern": "^(workspace:default|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      }
    }
  }
}
