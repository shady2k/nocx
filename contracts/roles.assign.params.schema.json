{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/roles.assign.params.schema.json",
  "title": "RolesAssignParams",
  "description": "Params for roles.assign.",
  "type": "object",
  "additionalProperties": false,
  "required": ["agentId", "role"],
  "properties": {
    "role": {
      "type": "string",
      "enum": ["answering", "classifier", "summarizing", "auditing"]
    },
    "model": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
