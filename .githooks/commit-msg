#!/bin/sh
# commit-msg — every commit names the leaf task it belongs to.
#
# AGENTS.md has asked for "(<bead-id>)" at the end of every subject since the
# tracker came in, checked by eye. The check is now check-commits.mjs, vendored
# from the shady2k-skills plugin and fed by commit-links.mjs, which reads the
# message by this repository's convention and resolves the ids against the
# tracker — closed tasks included, containers refused: a stage or an epic is
# not a task, and 76 of 593 commits in the week before this hook named one.
#
# Merges are covered too: git runs this hook for a merge it commits, and a
# merge that names nothing is linked by the commits it brings in. CI checks
# every introduced commit again, because this is one --no-verify away.
set -eu

gate=.githooks/backlog-gate
if [ ! -e "$gate/commit-links.mjs" ]; then
    if [ -e "$gate/config.json" ] ||
        git cat-file -e "HEAD:$gate/config.json" 2>/dev/null; then
        printf 'commit-msg: configured tree is missing %s/commit-links.mjs; run make connect\n' "$gate" >&2
        exit 1
    fi
    printf 'commit-msg: this tree has never configured commit-link checking; not checked here\n' >&2
    exit 0
fi
if ! command -v node >/dev/null 2>&1; then
    printf 'commit-msg: node is not on PATH; run make connect\n' >&2
    exit 1
fi
for f in adapter.mjs check-commits.mjs config.json; do
    if [ ! -r "$gate/$f" ]; then
        printf 'commit-msg: %s is missing or unreadable; run make connect\n' "$gate/$f" >&2
        exit 1
    fi
done
exec node "$gate/commit-links.mjs" --message "$1"
