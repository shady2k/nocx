{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/workspaces.recolour.params.schema.json",
  "title": "WorkspacesRecolourParams",
  "description": "Params for changing or clearing a workspace colour.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "colour": { "type": ["string", "null"], "maxLength": 64 }
  }
}
