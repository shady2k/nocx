{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/sandbox.status.schema.json",
  "title": "SandboxStatus",
  "description": "Result of the sandbox.status JSON-RPC method. Reports native backend availability for an interactive sandboxed shell.",
  "type": "object",
  "additionalProperties": false,
  "required": ["available", "backend"],
  "properties": {
    "available": { "type": "boolean" },
    "backend": { "type": "string", "enum": ["landlock", "seatbelt", "unsupported"] },
    "reason": { "type": "string" },
    "detail": { "type": "string" },
    "abi": { "type": "integer", "minimum": 0 }
  }
}
