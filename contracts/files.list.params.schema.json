{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/files.list.params.schema.json",
  "title": "FilesListParams",
  "description": "Params for files.list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bindingId", "path", "offset", "limit"],
  "properties": {
    "bindingId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "path": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "offset": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1 }
  }
}
