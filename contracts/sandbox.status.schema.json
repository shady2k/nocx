{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/sandbox.status.schema.json",
  "title": "SandboxStatusResult",
  "x-nocx-sharedTypes": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paneId",
    "workspaceId",
    "enabled",
    "standardRevision",
    "workspaceRevision",
    "profileSource",
    "availability",
    "reason",
    "source",
    "head",
    "preparingOperationId"
  ],
  "properties": {
    "paneId": { "type": "string" },
    "workspaceId": { "type": "string" },
    "enabled": { "type": "boolean" },
    "standardRevision": { "type": "integer", "minimum": 0 },
    "workspaceRevision": { "type": "integer", "minimum": 0 },
    "profileSource": { "type": "string" },
    "availability": { "type": "string" },
    "reason": { "type": "string" },
    "source": { "oneOf": [{ "$ref": "sandbox.source.schema.json" }, { "type": "null" }] },
    "head": { "oneOf": [{ "$ref": "sandbox.head.schema.json" }, { "type": "null" }] },
    "preparingOperationId": { "type": "string" }
  }
}
