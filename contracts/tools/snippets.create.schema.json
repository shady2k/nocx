{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "body"],
  "properties": { "title": { "type": "string" }, "body": { "type": "string" } },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "snippet"],
      "properties": {
        "status": { "const": "created" },
        "snippet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "body"],
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "body": { "type": "string" }
          }
        }
      }
    }
  }
}
