{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/agentRecords.save.params.schema.json",
  "title": "agentRecords.save params",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "command",
    "args",
    "icon",
    "colour",
    "disabled",
    "env",
    "resume"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "displayName": {
      "type": "string"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "icon": {
      "type": "string"
    },
    "colour": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    },
    "env": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resume": {
      "$ref": "#/$defs/resume"
    }
  },
  "$defs": {
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionIdArgs", "resumeIdArgs", "resumeCwdArgs"],
      "properties": {
        "sessionIdArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resumeIdArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resumeCwdArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
