{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/lifecycle.recoverAck.params.schema.json",
  "title": "LifecycleRecoverackParams",
  "description": "Exact acknowledgement of a sighted recovery episode. Raw recovery nonce fields are forbidden; episodeId is an independent non-secret identifier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "episodeId"],
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}"
    },
    "episodeId": {
      "type": "string",
      "pattern": "^rec-[0-9a-f]{32}$"
    }
  }
}
