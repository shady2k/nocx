{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/open.params.schema.json",
  "title": "OpenParams",
  "description": "Params for opening a terminal session. A present sandbox block selects Learn or Enforce; absent means Off.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cols", "rows"],
  "properties": {
    "cols": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "rows": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "xpixel": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "ypixel": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "kind": { "type": "string", "enum": ["local", "ssh"] },
    "profileId": { "type": "string", "maxLength": 128 },
    "host": { "type": "string", "maxLength": 253 },
    "user": { "type": "string", "maxLength": 256 },
    "shell": { "type": "string", "maxLength": 32 },
    "paneId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "mode", "settingsRevision"],
      "properties": {
        "workspace": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["learn", "enforce"] },
        "settingsRevision": { "type": "integer", "minimum": 0 },
        "profileRevision": { "type": ["integer", "null"], "minimum": 0 },
        "addWritable": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        },
        "removeWritable": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        },
        "addReadOnly": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        },
        "removeReadOnly": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "parent": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["sessionId", "instanceId", "sessionEpoch"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
        "instanceId": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
        "sessionEpoch": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
