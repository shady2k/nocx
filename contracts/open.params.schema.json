{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/open.params.schema.json",
  "title": "OpenParams",
  "description": "Params for opening a terminal session.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cols", "rows"],
  "properties": {
    "cols": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "rows": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "xpixel": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "ypixel": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "kind": { "type": "string", "enum": ["local", "ssh"] },
    "profileId": { "type": "string", "maxLength": 128 },
    "host": { "type": "string", "maxLength": 253 },
    "user": { "type": "string", "maxLength": 256 },
    "shell": { "type": "string", "maxLength": 32 },
    "paneId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "cwd": {
      "type": "string",
      "maxLength": 4096,
      "description": "The directory the pane's program starts in, for a LOCAL open (nocx-ouru5.1.4, the tab menu's Duplicate). A tab the person opens names none: its shell starts wherever an unconfigured local shell starts. A duplicate names the SOURCE pane's own verified report, because a copy standing in another directory is not one. Absent and empty are one answer. A far login shell cannot be moved, so an ssh open carrying one is refused rather than handed a value nothing acts on."
    },
    "parent": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["sessionId", "instanceId", "sessionEpoch"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
        "instanceId": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
        "sessionEpoch": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
