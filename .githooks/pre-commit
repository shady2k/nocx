#!/bin/sh
set -eu

warn() { printf "FAIL: %s\n" "$1"; }
ok()   { printf "OK:   %s\n" "$1"; }

# Tests run inside a container, never against the host filesystem.
. "$(dirname "$0")/containerized-tests.sh"

# go-installed tools (gofumpt, golangci-lint) live in $(go env GOPATH)/bin, which
# an interactive shell has on PATH but a hook invoked by an editor or a sandboxed
# process may not. Add it so the checks below find them wherever the hook runs.
command -v go >/dev/null 2>&1 && PATH="$(go env GOPATH)/bin:$PATH"

# --- check all binaries first, report all missing together ------------------
CHECK_CMD_TRUE=true
check_cmd() {
    if ! command -v "$1" >/dev/null 2>&1; then
        warn "$1 not found — install: $2"
        CHECK_CMD_TRUE=false
    fi
}

check_cmd gofumpt "go install mvdan.cc/gofumpt@latest"
check_cmd golangci-lint "go install github.com/golangci/golangci-lint/cmd/golangci-lint@v1.64.8"
check_cmd go "install Go from https://go.dev/dl/"
check_cmd node "install Node.js from https://nodejs.org/"
check_cmd npm "install Node.js from https://nodejs.org/"
check_cmd docker "start OrbStack or Docker Desktop — tests run in a container"

if [ ! -d frontend/node_modules ]; then
    warn "frontend/node_modules not found — run: cd frontend && npm ci"
    CHECK_CMD_TRUE=false
fi

if [ "$CHECK_CMD_TRUE" = false ]; then
    printf "\nPre-commit hook FAILED — install missing tools above and try again.\n"
    exit 1
fi

# --- 0. what does this commit touch? ----------------------------------------
# Scope the expensive per-language gates to the language the commit changes. The
# rule is conservative in one direction only: anything we cannot classify runs
# everything. A commit that cannot be classified is cheap; a commit that skips a
# gate it needed is a broken commit in a history AGENTS.md expects to bisect.
#
# Deletions are NOT filtered out — removing a file breaks a build as readily as
# editing one. An empty staged set (an --amend that changes only the message)
# also runs everything, because "nothing staged" is not evidence of safety.
RUN_GO=1
RUN_FE=1
CHANGED=$(git diff --cached --name-only 2>/dev/null || true)
if [ -n "$CHANGED" ]; then
    RUN_GO=0
    RUN_FE=0
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        case "$f" in
            # The hook and the build system decide how everything else is
            # checked, so a change to either invalidates the scoping itself.
            .githooks/*|Makefile|.golangci.yml) RUN_GO=1; RUN_FE=1 ;;
            *.go|go.mod|go.sum)                 RUN_GO=1 ;;
            frontend/*)                         RUN_FE=1 ;;
        esac
    done <<CHANGED_EOF
$CHANGED
CHANGED_EOF
fi

# --- 1. start the container gates now, in parallel --------------------------
# They share nothing — one is a Go toolchain, the other a Node one — and between
# them they were 72% of this hook's wall time when run in sequence. Starting them
# before the host-side linters means the linters run inside their shadow rather
# than after it.
GO_LOG=$(mktemp) || exit 1
FE_LOG=$(mktemp) || exit 1
GO_PID=""
FE_PID=""
cleanup() {
    [ -n "$GO_PID" ] && kill "$GO_PID" 2>/dev/null || true
    [ -n "$FE_PID" ] && kill "$FE_PID" 2>/dev/null || true
    rm -f "$GO_LOG" "$FE_LOG"
}
trap cleanup EXIT INT TERM

if [ "$RUN_GO" = 1 ]; then
    go_test_containerized >"$GO_LOG" 2>&1 &
    GO_PID=$!
fi
if [ "$RUN_FE" = 1 ]; then
    vitest_containerized >"$FE_LOG" 2>&1 &
    FE_PID=$!
fi

# host_gate runs a check and, on failure, prints it and aborts the commit. The
# background containers die with the shell via the EXIT trap.
host_gate() {
    _label=$1
    shift
    if ! "$@" 2>&1; then
        warn "$_label"
        printf "\nPre-commit hook FAILED. Fix the issues above and try again.\n"
        exit 1
    fi
    ok "$_label"
}

# --- 2. gofumpt (always: one second, and it reads the whole module) ----------
UNFMT=$(gofumpt -l . 2>&1) || true
if [ -n "$UNFMT" ]; then
    warn "gofumpt — the following files need formatting:"
    printf "%s\n" "$UNFMT"
    printf "\nPre-commit hook FAILED. Fix the issues above and try again.\n"
    exit 1
fi
ok "gofumpt"

# --- 3. golangci-lint (always: it is cached and effectively free) -----------
host_gate "golangci-lint" golangci-lint run ./...

# --- 4. prettier (always: it covers markdown and config the scoping misses) --
host_gate "prettier --check" sh -c 'cd frontend && npm run format:check'

# --- 5. frontend-only host gates --------------------------------------------
if [ "$RUN_FE" = 1 ]; then
    host_gate "eslint" sh -c 'cd frontend && npm run lint'
    host_gate "solid negative fixture gate" sh -c 'cd frontend && npm run lint:fixture-check'
    host_gate "wire contracts current" sh -c 'cd frontend && npm run contracts:check'
    host_gate "tsc --noEmit" sh -c 'cd frontend && npm run typecheck'
else
    ok "eslint, fixture gate, tsc — skipped (no frontend/ changes staged)"
fi

# --- 6. collect the container gates -----------------------------------------
# Waited on separately so a failure names the runner that produced it; a merged
# log would leave the reader guessing which toolchain spoke.
GO_RC=0
FE_RC=0
if [ -n "$GO_PID" ]; then
    wait "$GO_PID" || GO_RC=$?
    GO_PID=""
    if [ "$GO_RC" -ne 0 ]; then
        warn "go test -race (container)"
        cat "$GO_LOG"
    else
        ok "go test -race (container)"
    fi
else
    ok "go test -race — skipped (no Go changes staged)"
fi

if [ -n "$FE_PID" ]; then
    wait "$FE_PID" || FE_RC=$?
    FE_PID=""
    if [ "$FE_RC" -ne 0 ]; then
        warn "vitest (container)"
        cat "$FE_LOG"
    else
        ok "vitest (container)"
    fi
else
    ok "vitest — skipped (no frontend/ changes staged)"
fi

if [ "$GO_RC" -ne 0 ] || [ "$FE_RC" -ne 0 ]; then
    printf "\nPre-commit hook FAILED. Fix the issues above and try again.\n"
    exit 1
fi

# --- 7. beads: materialise the issue snapshot into this commit ---------------
# Last, deliberately: a gate that fails above must not leave .beads/issues.jsonl
# rewritten and staged for a commit that never happens.
. "$(dirname "$0")/beads-hook.sh"
export_beads_snapshot
ok "beads export"

printf "\nAll checks passed.\n"
