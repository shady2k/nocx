{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/open.params.schema.json",
  "title": "OpenParams",
  "description": "Params for opening a terminal session.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cols", "rows"],
  "properties": {
    "cols": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "rows": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "xpixel": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "ypixel": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "kind": { "type": "string", "enum": ["local", "ssh"] },
    "profileId": { "type": "string", "maxLength": 128 },
    "host": { "type": "string", "maxLength": 253 },
    "user": { "type": "string", "maxLength": 256 },
    "shell": { "type": "string", "maxLength": 32 },
    "desiredMode": {
      "type": "string",
      "enum": ["raw", "script", "helper"],
      "description": "A one-shot integration-method override for THIS open alone (ADR-0069). Set only by a retry after the connect-time ask was answered for a hand-typed ssh session with no saved connection — there is nowhere else to keep the choice, so it rides the very open it answers. Ignored (the resolved connection's own desiredMode governs) once a profileId or a matched saved connection is in play, since the answer for those was written to the connection itself."
    },
    "paneId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "parent": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["sessionId", "instanceId", "sessionEpoch"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
        "instanceId": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
        "sessionEpoch": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
