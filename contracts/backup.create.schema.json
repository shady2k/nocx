{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/backup.create.schema.json",
  "title": "BackupCreateResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["fileName", "contents", "summary"],
  "properties": {
    "fileName": {
      "type": "string"
    },
    "contents": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings",
        "connections",
        "groups",
        "snippets",
        "notes",
        "credentialBindingsRemoved",
        "groupCredentialBindingsRemoved",
        "groupDefaultKeysOmitted"
      ],
      "properties": {
        "settings": {
          "type": "integer"
        },
        "connections": {
          "type": "integer"
        },
        "groups": {
          "type": "integer"
        },
        "snippets": {
          "description": "The number of snippets in the backup. 0 when the service has no snippet store or the library is empty.",
          "type": "integer"
        },
        "credentialBindingsRemoved": {
          "type": "integer"
        },
        "groupCredentialBindingsRemoved": {
          "type": "integer"
        },
        "groupDefaultKeysOmitted": {
          "type": "integer"
        },
        "notes": {
          "description": "The number of notes in the backup. 0 when the service has no notes store or the library is empty.",
          "type": "integer"
        }
      }
    }
  }
}
