{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/agent.status.schema.json",
  "title": "AgentStatusResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["answering", "message"],
  "properties": {
    "message": {
      "type": ["string", "null"]
    },
    "answering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "reason", "agentId", "model"],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "reason": {
          "enum": [null, "not-installed", "not-configured", "model-gone", "unavailable"]
        },
        "agentId": {
          "type": ["string", "null"]
        },
        "model": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
