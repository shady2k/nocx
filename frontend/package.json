{
  "name": "nocx-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0 && node lint-fixtures/check-css-colors.mjs && node lint-fixtures/check-css-integrity.mjs && node lint-fixtures/check-dead-exports.mjs && node lint-fixtures/check-two-owners.mjs && node lint-fixtures/check-row-grammar.mjs",
    "lint:dead-exports": "node lint-fixtures/check-dead-exports.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "lint:fixture-check": "sh ./lint-fixtures/gate.sh",
    "baseline:update": "node lint-fixtures/update-raw-controls-baseline.mjs",
    "baseline:color-update": "node lint-fixtures/update-color-literals-baseline.mjs",
    "baseline:inline-update": "node lint-fixtures/update-inline-markup-baseline.mjs",
    "baseline:dead-exports-update": "node lint-fixtures/update-dead-exports-baseline.mjs",
    "contracts": "node scripts/gen-contracts.mjs",
    "contracts:check": "node scripts/gen-contracts.mjs --check",
    "lint:two-owners": "node lint-fixtures/check-two-owners.mjs",
    "baseline:two-owners-update": "node lint-fixtures/update-two-owners-baseline.mjs",
    "lint:row-grammar": "node lint-fixtures/check-row-grammar.mjs",
    "baseline:row-grammar-update": "node lint-fixtures/update-row-grammar-baseline.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@shikijs/langs": "4.4.1",
    "@shikijs/themes": "4.4.1",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "shiki": "4.4.1",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "26.1.2",
    "css-tree": "^3.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-solid": "^0.14.5",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "knip": "^6.32.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
