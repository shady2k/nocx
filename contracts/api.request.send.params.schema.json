{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/api.request.send.params.schema.json",
  "title": "APIRequestSendParams",
  "description": "Params for api.request.send.",
  "type": "object",
  "additionalProperties": false,
  "required": ["handle", "relPath", "token"],
  "properties": {
    "handle": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "relPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "envRelPath": { "type": "string", "maxLength": 4096 },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Capability token authorizing this API request send."
    }
  }
}
