{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {},
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snippets", "truncated", "dropped"],
      "properties": {
        "snippets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "body"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "body": { "type": "string" }
            }
          }
        },
        "truncated": { "type": "boolean" },
        "dropped": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
