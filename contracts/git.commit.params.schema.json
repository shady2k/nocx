{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/git.commit.params.schema.json",
  "title": "GitCommitParams",
  "description": "Params for git.commit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bindingId", "message", "amend"],
  "properties": {
    "bindingId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "message": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "amend": { "type": "boolean" }
  }
}
