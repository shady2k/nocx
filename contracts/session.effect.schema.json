{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/session.effect.schema.json",
  "title": "SessionEffect",
  "description": "One identity-bearing non-visual effect emitted by the session runtime. A full session.frame never carries or replays effects; the client deduplicates this event across replay and reconnect by generation and effectId.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "generation", "effectId", "kind", "title", "body"],
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "effectId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "kind": {
      "type": "string",
      "enum": ["bell", "notification", "clipboard", "title", "cwd", "promptBoundary", "recovery"]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "episodeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^rec-[0-9a-f]{32}$"
    },
    "screenRevision": {
      "type": "integer",
      "minimum": 1,
      "description": "For promptBoundary only, the lower-bound full-frame revision that must be offered first. It is correlation, not acknowledgement or authority."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "recovery"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["episodeId"],
        "properties": {
          "title": {
            "const": ""
          },
          "body": {
            "const": ""
          }
        }
      },
      "else": {
        "not": {
          "required": ["episodeId"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "promptBoundary"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["screenRevision"]
      },
      "else": {
        "not": {
          "required": ["screenRevision"]
        }
      }
    }
  ]
}
