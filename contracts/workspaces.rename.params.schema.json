{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/workspaces.rename.params.schema.json",
  "title": "WorkspacesRenameParams",
  "description": "Params for renaming a workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "name": { "type": "string", "pattern": ".*\\S.*", "maxLength": 200 }
  }
}
