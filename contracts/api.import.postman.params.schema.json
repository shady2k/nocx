{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/api.import.postman.params.schema.json",
  "title": "APIImportPostmanParams",
  "description": "Params for api.import.postman.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dest"],
  "properties": {
    "path": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "document": { "type": "string", "maxLength": 1048576 },
    "archiveBytes": { "type": "string", "contentEncoding": "base64" },
    "url": { "type": "string", "minLength": 1 },
    "route": { "$ref": "#/$defs/route" },
    "dest": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "preview": { "type": "boolean" }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "profileId", "insecureTls"],
      "properties": {
        "kind": { "type": "string", "enum": ["direct", "connection"] },
        "profileId": { "type": "string", "maxLength": 256 },
        "insecureTls": { "type": "boolean" }
      }
    }
  },
  "oneOf": [
    { "required": ["path"] },
    { "required": ["document"] },
    { "required": ["archiveBytes"] },
    { "required": ["url"] }
  ],
  "allOf": [{ "if": { "required": ["route"] }, "then": { "required": ["url"] } }]
}
