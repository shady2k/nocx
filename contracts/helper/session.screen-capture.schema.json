{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/helper/session.screen-capture.schema.json",
  "title": "HelperSessionScreenCaptureResult",
  "description": "One coherent backend-owned active-buffer capture. Rows are exactly the absolute [start,end) interval; floor and total state the retained buffer bounds, identity names the buffer instance and geometry, and revision/completeness describe the same runtime instant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "floor",
    "start",
    "end",
    "total",
    "rows",
    "cursorX",
    "cursorY",
    "cursorVisible",
    "identity",
    "revision",
    "completeness"
  ],
  "properties": {
    "floor": {
      "type": "integer",
      "minimum": 0
    },
    "start": {
      "type": "integer",
      "minimum": 0
    },
    "end": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "rows": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "array",
        "maxItems": 2000,
        "items": {
          "$ref": "https://nocx.local/contracts/helper/identities.schema.json#/$defs/screenCell"
        }
      }
    },
    "cursorX": {
      "type": "integer",
      "minimum": 0
    },
    "cursorY": {
      "type": "integer",
      "minimum": 0
    },
    "cursorVisible": {
      "type": "boolean"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "instance", "cols", "rows", "generation"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["normal", "alternate"]
        },
        "instance": {
          "type": "integer",
          "minimum": 0
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "completeness": {
      "$ref": "https://nocx.local/contracts/helper/identities.schema.json#/$defs/completeness"
    }
  }
}
