{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/vault.unseal.params.schema.json",
  "title": "VaultUnsealParams",
  "description": "Params for vault.unseal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["means"],
  "properties": {
    "means": { "type": "string", "enum": ["os", "passphrase", "recovery"] },
    "secret": {
      "type": "string",
      "maxLength": 64000,
      "description": "Passphrase or recovery material; never log or echo it."
    },
    "secretId": { "type": "string", "maxLength": 256 }
  }
}
